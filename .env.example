# Local development settings. Copy to .env (git-ignored) and load it in the
# run target, for example with `dotenv: ['.env']` in the Taskfile.
#
# Local dev logs everything in human-readable form. Cluster environments set
# their own level and always log JSON: dev cluster debug, qa/staging info,
# production error.
LOG_LEVEL=trace
LOG_FORMAT=console

# Required.
DATABASE_DSN=postgres://delivery:delivery@localhost:5432/delivery?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
CORE_GRPC_ADDR=localhost:9091

# Service-to-service authentication. Local runs have no cluster issuer or
# projected token, so it is switched off; delivery warns and reports itself
# degraded. In a cluster set WORKLOAD_TOKEN_FILE, WORKLOAD_OIDC_ISSUER and
# WORKLOAD_ALLOWED_SERVICEACCOUNTS instead.
WORKLOAD_AUTH=disabled

# Ports: gRPC, plain HTTP for /livez and /readyz, and the internal HTTP port
# the PDF renderer fetches policy HTML from.
GRPC_PORT=9090
PROBE_PORT=8080
INTERNAL_HTTP_PORT=8081

# Magic-link lifetimes and the PDF download link lifetime.
MAGIC_LINK_NONSENSITIVE_TTL=720h
MAGIC_LINK_SENSITIVE_TTL=48h
PDF_LINK_TTL=15m

# PDF export: off outside a cluster. The bucket is the one the renderer
# writes into (S3, such as RustFS).
PDF_EXPORT_ENABLED=false
INTERNAL_BASE_URL=
POD_NAMESPACE=default
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
